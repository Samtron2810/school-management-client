# Copy to .env.development (or .env.local) for local development.
# Vite only exposes vars prefixed with VITE_ to client code.

# Base URL of the backend API (school-management-server).
# Defaults to http://localhost:5000/api/v1 if unset.
VITE_API_URL=http://localhost:5000/api/v1

# Dev-only: when "true", falls back to a mock login session if a real
# POST /auth/login call fails (useful for UI work without a running
# backend). Ignored in production builds. Leave unset/false once the
# backend is reachable.
VITE_MOCK_AUTH=false
